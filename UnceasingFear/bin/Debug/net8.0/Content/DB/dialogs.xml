<?xml version="1.0" encoding="utf-8"?>
<Dialogs>
	<Dialog id="calm_goblin_01">
		<Node id="start" speaker="Calm Goblin" text="Hello traveler. The woods are quiet today.">
			<Choice text="Tell me more." action="Continue" target="reply_1" />
			<Choice text="Show me your wares." action="UnitShop" target="goblin_shop_01" />
			<Choice text="Draw your weapon!" action="AttackCurrent" target="goblin_surrenders:goblin_laugh" />
			
			<!-- Example 1: Simple Stat Check -->
			<Choice text="Do I look fine?" action="Continue" target="goblin_impressed:goblin_disgusted">
				<Condition type="StatCheck" value="CurrentHp:20" />
			</Choice>

			<!-- Example 2: Check if player has an item, and take it! -->
			<Choice text="Here is the 5 Gold you asked for." action="Continue" target="goblin_happy:goblin_angry">
				<Condition type="TakeItem" value="Gold:5" />
			</Choice>
			<!-- Example 3: Give the player an item as a reward -->
			<Choice text="Do you have some Hearbs?" action="Continue" target="recive_item">
				<ReciveItems>
					<Item type="Hearb" name="Hearb" quantity="1" value="1" description="A fresh herb." IsStackable="1"/>
				</ReciveItems>
			</Choice>
			<!-- Example 4: Multiple conditions (Must have 10 Gold AND Physic > 5) -->
			<Choice text="I am a strong and rich traveler!" action="Continue" target="strong_rich:not_strong_rich">
				<Condition type="HasItem" value="Gold:10" />
				<Condition type="StatCheck" value="Physic:5" />
			</Choice>

			<!-- Example 5: Multiple conditions -->
			<Choice text="I will but Hearb for 5 gold. (Need to have 5 Physic!)" action="Continue" target="deal:not_deal">
				<Condition type="StatCheck" value="Physic:5" />
				<Condition type="TakeItem" value="Gold:5" />
				<ReciveItems>
					<Item type="Hearb" name="Hearb" quantity="1" value="1" description="A fresh herb." IsStackable="1"/>
				</ReciveItems>
			</Choice>
			
			<Choice text="Goodbye." action="End" target="start" />
		</Node>
		
		<Node id="goblin_impressed" speaker="Calm Goblin" text="You looks good for me.">
			<Choice text="..." action="Continue" target="start" />
		</Node>
		<Node id="goblin_disgusted" speaker="Calm Goblin" text="You are injured.">
			<Choice text="..." action="Continue" target="start" />
		</Node>
		<Node id="goblin_happy" speaker="Calm Goblin" text="Perfect!">
			<Choice text="..." action="Continue" target="start" />
		</Node>
		<Node id="goblin_angry" speaker="Calm Goblin" text="You don't even have money!">
			<Choice text="..." action="Continue" target="start" />
		</Node>
		<Node id="recive_item" speaker="Calm Goblin" text="I do in fact.">
			<Choice text="..." action="Continue" target="start" />
		</Node>
		<Node id="strong_rich" speaker="Calm Goblin" text="You are strong and rich!">
			<Choice text="..." action="Continue" target="start" />
		</Node>
		<Node id="not_strong_rich" speaker="Calm Goblin" text="Don't looks like it.">
			<Choice text="..." action="Continue" target="start" />
		</Node>

		<Node id="deal" speaker="Calm Goblin" text="Deal!">
			<Choice text="..." action="Continue" target="start" />
		</Node>
		<Node id="not_deal" speaker="Calm Goblin" text="You don't pass requirements!">
			<Choice text="..." action="Continue" target="start" />
		</Node>
		
		
		<Node id="reply_1" speaker="Calm Goblin" text="Nice day, isn't it? Watch out for slimes.">
			<Choice text="Show me your wares." action="UnitShop" target="goblin_shop_01" />
			<Choice text="Indeed. Farewell." action="End" target="reply_1" />
		</Node>
		<Node id="goblin_surrenders" speaker="Calm Goblin" text="Okay, okay! You win. Here is my gold.">
			<Choice text="Goodbye." action="End" target="goblin_surrenders" />
		</Node>
		<Node id="goblin_laugh" speaker="Calm Goblin" text="Hah! You are too weak. Leave my sight.">
			<Choice text="..." action="End" target="goblin_laugh" />
		</Node>
	</Dialog>
</Dialogs>